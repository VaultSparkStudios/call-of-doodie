{
  "name": "call-of-doodie",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-public-pages.mjs && node scripts/generate-public-gameplay-contract.mjs && node scripts/generate-icons.mjs",
    "build": "vite build",
    "build:deployable": "node scripts/build-deployable.mjs",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-icons.mjs",
    "launch:assets": "node scripts/generate-launch-assets.mjs",
    "launch:readiness": "node scripts/launch-readiness.mjs",
    "lint": "eslint src --report-unused-disable-directives",
    "lint:strict": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/validate-coverage-contract.mjs",
    "coverage:check": "node scripts/validate-coverage-contract.mjs",
    "launch:smoke": "vitest run src/App.launch.test.jsx",
    "public:contract": "node scripts/validate-public-contract.mjs",
    "gameplay:contract": "node scripts/generate-public-gameplay-contract.mjs",
    "health:check": "node scripts/health-check.mjs",
    "live:site-check": "node scripts/live-site-check.mjs",
    "launch:surfaces": "node scripts/launch-surface-check.mjs",
    "security:release": "node scripts/security-release-gate.mjs",
    "security:release:audit": "node scripts/security-release-gate.mjs --npm-audit",
    "deps:check": "node scripts/check-dependency-tree.mjs",
    "entry:boundaries": "node scripts/check-entry-vendor-boundaries.mjs",
    "leaderboard:shared-check": "node scripts/shared-leaderboard-check.mjs",
    "replay:trust-smoke": "node scripts/replay-trust-smoke.mjs",
    "replay:edge-fixtures": "node scripts/validate-edge-replay-pressure-fixtures.mjs",
    "post-cutover:smoke": "node scripts/post-cutover-smoke.mjs",
    "launch:qa": "node scripts/health-check.mjs && node scripts/live-site-check.mjs && node scripts/launch-surface-check.mjs",
    "launch:verify": "vitest run src/App.launch.test.jsx && node scripts/health-check.mjs && node scripts/live-site-check.mjs && node scripts/launch-surface-check.mjs && node scripts/security-release-gate.mjs --npm-audit && node scripts/shared-leaderboard-check.mjs",
    "assets:generate": "node scripts/generate-proprietary-visual-assets.mjs",
    "assets:check": "node scripts/validate-visual-assets.mjs",
    "launch:screenshots": "node scripts/capture-launch-screenshots.mjs",
    "visual:audit": "node scripts/audit-staging-visuals.mjs",
    "visual:receipt": "node scripts/write-visual-qa-receipt.mjs",
    "deploy:staging": "node scripts/deploy-staging-preview.mjs",
    "launch:media-check": "node scripts/validate-launch-media.mjs",
    "home:retirement-gate": "node scripts/legacy-home-retirement-gate.mjs",
    "audit:env": "node scripts/audit-env.mjs",
    "audit:env:site": "node scripts/audit-env.mjs site",
    "audit:env:functions": "node scripts/audit-env.mjs functions",
    "audit:env:deploy": "node scripts/audit-env.mjs deploy",
    "protocol:drift": "node scripts/protocol-drift-check.mjs",
    "startup:acceptance": "node scripts/check-startup-acceptance.mjs",
    "manifest:reconcile": "node scripts/reconcile-studio-manifest.mjs",
    "manifest:check": "node scripts/reconcile-studio-manifest.mjs --check",
    "performance:capture": "node scripts/capture-production-performance.mjs",
    "asset-boundary:check": "node scripts/check-entry-asset-boundary.mjs",
    "runtime:boundary": "node scripts/check-runtime-boundary.mjs",
    "domain:cloudflare:plan": "node scripts/cloudflare-domain-cutover.mjs",
    "domain:cloudflare:apply": "node scripts/cloudflare-domain-cutover.mjs --apply",
    "domain:platform:plan": "node scripts/platform-domain-cutover.mjs",
    "domain:platform:apply": "node scripts/platform-domain-cutover.mjs --apply",
    "schema:lint": "node scripts/schema-lint.mjs && node scripts/check-current-state-coherence.mjs && node scripts/check-app-architecture.mjs && node scripts/check-boot-storage-boundary.mjs && node scripts/check-task-semantics.mjs && node scripts/check-project-status-writers.mjs && node scripts/check-node-runtime.mjs && node scripts/record-skill-cost.mjs --check",
    "runtime:node": "node scripts/check-node-runtime.mjs",
    "canon:adoption-check": "node scripts/check-canon-adoption-ledger.mjs",
    "architecture:check": "node scripts/check-app-architecture.mjs",
    "storage:boundary": "node scripts/check-boot-storage-boundary.mjs",
    "infrastructure:schedule-check": "node scripts/check-schedule-policy.mjs",
    "leaderboard:audit": "node scripts/leaderboard-audit.mjs --strict",
    "leaderboard:quarantine": "node scripts/leaderboard-audit.mjs --quarantine --strict",
    "migration:apply": "node scripts/apply-supabase-migration.mjs --apply",
    "functions:deploy": "node scripts/deploy-supabase-functions.mjs",
    "replay:state-stepper": "node scripts/validate-replay-state-stepper-fixtures.mjs",
    "progression:audit": "node scripts/progression-curve-audit.mjs"
    ,"context:hot": "node scripts/render-hot-context.mjs"
    ,"context:hot:check": "node scripts/render-hot-context.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "gifenc": "^1.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.3",
    "nanoid": "3.3.17",
    "picomatch": "4.0.4",
    "postcss": "8.5.23",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@sentry/react": "^8.55.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "sharp": "^0.35.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.8"
  }
}
